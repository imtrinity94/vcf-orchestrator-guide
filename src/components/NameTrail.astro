---
const names = [
  { y: '2007', n: 'VMware Orchestrator', d: 'VMware acquires Dunes and its Virtual Service Orchestrator' },
  { y: '2009', n: 'vCenter Orchestrator (vCO)', d: 'Ships alongside vSphere 4.0' },
  { y: '2014', n: 'vRealize Orchestrator (vRO)', d: 'Renamed with the vRealize suite' },
  { y: '2019', n: 'vRO 8', d: 'Rebuilt as a Kubernetes-based Photon OS appliance' },
  { y: '2022', n: 'Aria Automation Orchestrator', d: 'Renamed with the Aria portfolio' },
  { y: '2025', n: 'VCF Operations Orchestrator', d: 'Becomes part of VMware Cloud Foundation 9' },
];
---
<ol class="nt not-content">
  {names.map((x, i) => (
    <li class:list={{ now: i === names.length - 1 }}>
      <span class="y">{x.y}</span>
      <span class="n">{x.n}</span>
      <span class="d">{x.d}</span>
    </li>
  ))}
</ol>
<style>
  .nt { list-style: none; padding: 0; margin: 1.5rem 0; font-family: var(--sl-font); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; }
  .nt li { position: relative; padding: 1.4rem 0.75rem 0 0; margin: 0; border-top: 2px solid var(--sl-color-gray-5); }
  .nt li::before { content: ''; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--sl-color-gray-4); }
  .nt li.now::before { background: var(--ob-start); }
  .nt .y { display: block; font-size: 0.8rem; font-weight: 600; color: var(--sl-color-gray-3); }
  .nt .n { display: block; font-weight: 700; line-height: 1.25; margin: 0.15rem 0 0.3rem; color: var(--sl-color-white); }
  .nt .now .n { color: var(--ob-start); }
  .nt .d { display: block; font-size: 0.8rem; line-height: 1.35; color: var(--sl-color-gray-3); }
  @media (max-width: 50rem) {
    .nt { grid-template-columns: 1fr; }
    .nt li { border-top: 0; border-left: 2px solid var(--sl-color-gray-5); padding: 0 0 1rem 1.2rem; }
    .nt li::before { top: 0.15rem; left: -7px; }
  }
</style>
