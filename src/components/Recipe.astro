---
// A recipe section that hangs off the vertical "workflow line".
// type: ready (start node) | how | works (task nodes) | more (decision node) | see (end node)
interface Props { type: 'ready' | 'how' | 'works' | 'more' | 'see'; title?: string }
const { type, title } = Astro.props;
const meta = {
  ready: { label: 'Getting ready', node: 'start' },
  how: { label: 'How to do it', node: 'task' },
  works: { label: 'How it works', node: 'task' },
  more: { label: "There's more", node: 'decision' },
  see: { label: 'See also', node: 'end' },
}[type];
---
<section class:list={['rs', `rs-${meta.node}`]}>
  <div class="rs-node" aria-hidden="true">
    {meta.node === 'start' && (
      <svg viewBox="0 0 30 30"><circle cx="15" cy="15" r="12" fill="var(--ob-start)" /><path d="M12 9.5 20 15l-8 5.5z" fill="var(--sl-color-black)" /></svg>
    )}
    {meta.node === 'task' && (
      <svg viewBox="0 0 30 30"><rect x="3" y="5" width="24" height="20" rx="3.5" fill="var(--sl-color-black)" stroke="var(--ob-task)" stroke-width="2.2" /><path d="M11.5 11.5 8.5 15l3 3.5M18.5 11.5l3 3.5-3 3.5" fill="none" stroke="var(--ob-task)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    )}
    {meta.node === 'decision' && (
      <svg viewBox="0 0 30 30"><path d="M15 2.5 27.5 15 15 27.5 2.5 15z" fill="var(--sl-color-black)" stroke="var(--ob-decision)" stroke-width="2.2" stroke-linejoin="round" /><path d="M15 10v6" stroke="var(--ob-decision)" stroke-width="2.2" stroke-linecap="round" /><circle cx="15" cy="19.5" r="1.3" fill="var(--ob-decision)" /></svg>
    )}
    {meta.node === 'end' && (
      <svg viewBox="0 0 30 30"><circle cx="15" cy="15" r="11.5" fill="var(--sl-color-black)" stroke="var(--ob-end)" stroke-width="2.2" /><circle cx="15" cy="15" r="6.5" fill="var(--ob-end)" /></svg>
    )}
  </div>
  <h3 class="rs-title">{title ?? meta.label}</h3>
  <div class="rs-body"><slot /></div>
</section>
